# Supabase project endpoint. Keep this file as a template; never commit backend/.env.
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend only. Use a server-side key (service_role or a tightly scoped secret key).
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated development origins.
CORS_ORIGINS=http://localhost:5173
